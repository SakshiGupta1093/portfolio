# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets live here and must NEVER be committed.
# .env.local holds GROQ_API_KEY. It is listed explicitly so the intent is obvious.
.env.local
.env*
# .env.example is a safe template with empty values, so it IS committed.
!.env.example

# generated from assets/screenshots by scripts/sync-screenshots.mjs
/public/screenshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
